# Host folder mounted at /data. BOOKS_ROOT and AUDIOBOOKS_ROOT are paths inside that mount.
DATA_ROOT=./data

# Host folder for stager.db, logs, and the rotated MAM cookie. Mounted at /config.
STAGER_CONFIG_HOST=./config

AUDIOBOOK_STAGER_PORT=9570
TZ=America/Denver

BOOKS_ROOT=/data/Dropbox/Books
AUDIOBOOKS_ROOT=/data/Audiobooks

GOOGLE_BOOKS_API_KEY=
METADATA_CONTACT_EMAIL=
AUDNEXUS_MIN_INTERVAL_MS=500
OPENLIBRARY_MIN_INTERVAL_MS=1000
AUDNEXUS_REGION=us

# Bootstrap cookie for metadata search. After the first response the live value
# is written to STAGER_CONFIG_HOST/mam.cookies. Use a session that is not the
# VPN seedbox cookie.
STAGER_MAM_ID=
MAM_REQUESTS_PER_MINUTE=120
