# Host folder mounted at /data.
# Host ./data/seeds and ./data/library are container /data/seeds and /data/library.
DATA_ROOT=./data

# Host folder for the database and local config. Mounted at /config.
STAGER_CONFIG_HOST=./config

AUDIOBOOK_STAGER_PORT=9570
TZ=UTC

# Container paths inside the /data mount.
BOOKS_ROOT=/data/seeds
AUDIOBOOKS_ROOT=/data/library

# Compose sets the container config root to /config. Leave these blank to keep that.
# STAGING_CONFIG_ROOT overrides STAGER_CONFIG_ROOT when set.
STAGER_CONFIG_ROOT=
STAGING_CONFIG_ROOT=

# Optional.
GOOGLE_BOOKS_API_KEY=

# Blank does not gate Open Library.
METADATA_CONTACT_EMAIL=

AUDNEXUS_MIN_INTERVAL_MS=500
OPENLIBRARY_MIN_INTERVAL_MS=1000
AUDNEXUS_REGION=us

# Optional.
STAGER_MAM_ID=

# Optional. Used only when STAGER_MAM_ID is empty.
MAM_ID=

MAM_REQUESTS_PER_MINUTE=120

# Optional.
STAGER_MAM_COOKIE_FILE=
MAM_COOKIE_FILE=

# Optional.
CONFIG_ROOT=

# Optional. Leave blank for a normal run.
STAGER_METADATA_BACKEND=
STAGER_METADATA_FIXTURES=
STAGER_FIXTURE_LOOKUP_DELAY_MS=

# Optional.
SCAN_FINGERPRINT_WORKERS=
